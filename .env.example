# Runtime
NODE_ENV="development"
LOCKED="FALSE"

# Data
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE"
DATABASE_SSL="disable"
SQLITE_PATH="./data.db"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
TOTP_ISSUER="Byg"

# Email
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="Byg <noreply@up.byg.gg>"

# Web / URLs
BASE_URL="http://localhost:2257"

# OAuth (Yandex)
YANDEX_OAUTH_CLIENT_ID="your_yandex_client_id"
YANDEX_OAUTH_CLIENT_SECRET="your_yandex_client_secret"
API_PUBLIC_BASE_URL="http://localhost:2255"
# Optional: override the default API_PUBLIC_BASE_URL callback path.
# YANDEX_OAUTH_REDIRECT_URI="http://localhost:2255/auth/oauth/yandex/callback"

# Search
SEARXNG_BASE_URL="https://your-searxng-instance.example.com"

# Observability
POSTHOG_PROJECT_TOKEN="phc_xxxxxxxxxxxxxxxxxxxxx"
POSTHOG_LOGS_URL="https://us.i.posthog.com/i/v1/logs"
OTEL_SERVICE_NAME="byg-api-dev"

# Push
VAPID_SUBJECT="mailto:alerts@example.com"
VAPID_PUBLIC_KEY="your_public_vapid_key"
VAPID_PRIVATE_KEY="your_private_vapid_key"

# Geolocation
IPINFO_KEY=your_ipinfo.io_key
